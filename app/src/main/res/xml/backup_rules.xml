<?xml version="1.0" encoding="utf-8"?><!--
  FIX S-2 (audit c03919d): the credential vault SharedPreferences file is
  EXCLUDED from Android Auto Backup. Previously the sample template had no
  rules while allowBackup="true", so the encrypted credentials prefs file
  (and the old fallback software key) was silently synced to the user's
  cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_vault_credentials.xml" />
</full-backup-content>
