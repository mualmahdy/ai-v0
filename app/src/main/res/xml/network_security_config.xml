<?xml version="1.0" encoding="utf-8"?>
<!--
  REPAIR ORDER §17 — NARROWEST safe network-security configuration.

  Problem: the app defaults to LOCAL Ollama endpoints over cleartext HTTP
  (http://127.0.0.1:11434, http://10.0.2.2:11434). With targetSdk 36 the
  platform blocks cleartext by default (API 28+), so every default Ollama
  configuration was dead at the OS level. The previous "fix" temptation —
  android:usesCleartextTraffic="true" — would have globally weakened
  security for EVERY remote endpoint. This config instead permits cleartext
  ONLY for the local-development endpoints that genuinely need it:

    - localhost / 127.0.0.1 / [::1]  (true on-device loopback servers)
    - 10.0.2.2                       (Android EMULATOR host-machine alias —
                                       explicitly NOT on-device)
    - 169.254.*                      (link-local, emulator adb reverse)

  Everything else — all internet hosts, all LAN addresses — remains
  cleartext-BLOCKED (HTTPS required). A user's LAN Ollama server
  (192.168.x.x / 10.x.x.x) must be exposed via HTTPS or explicitly added
  here by the user; we do not silently widen the policy for the whole app.
-->
<network-security-config>
    <!-- Default: NO cleartext anywhere. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Loopback + emulator-host alias ONLY (narrowest safe carve-outs). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">169.254.0.2</domain>
    </domain-config>
</network-security-config>
