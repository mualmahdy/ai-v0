<?xml version="1.0" encoding="utf-8"?><!--
  FIX S-2 (audit c03919d): the credential vault SharedPreferences file is
  EXCLUDED from both cloud backup and device-to-device transfer. Previously
  this file was the commented sample template with no active rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_vault_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_vault_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
