<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Durable Android execution (audit 2026 fix): foreground shell for
         long-running agent tasks so process priority stays high. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- STAGE 7 (user round 3 — the in-app phone-storage browser): devices
         without a DocumentsUI activity (no SAF picker at all) browse the
         REAL phone storage through java.io.File, which needs real storage
         access: All-Files-Access on API 30+ (an explicit user-granted
         settings toggle), READ_EXTERNAL_STORAGE at runtime on API ≤29.
         The browser states exactly what it needs and why when access is
         missing — never a silent empty list. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <service
            android:name="com.example.application.execution.AgentExecutionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <!-- IME (§4A, user round 4): the window must NEVER resize for the
                 soft keyboard — WindowInsets.ime is the SINGLE source of
                 truth and the composer's imePadding() is the SINGLE bottom
                 contributor of the chain. adjustResize was the surviving
                 double-booker on the reported ROM: the window panned
                 (resized) for the keyboard while imePadding() ALSO padded
                 by the reported ime inset — the composer rode a full
                 keyboard-height of blank above the keyboard, exactly the
                 user's report (the round-3 Scaffold pin killed the injected
                 systemBars.bottom but not the window resize itself).
                 adjustNothing keeps the window laid out full-screen at all
                 times (edge-to-edge stays honest), the IME insets are
                 dispatched as before, and nothing else in the chain moves:
                 on API 35+ this is already the forced behavior (a no-op
                 declaration), while on API 24–34 it removes the resize
                 contributor on every device. -->
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
